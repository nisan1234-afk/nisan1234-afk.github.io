  <!-- 8 -->
  <section class="slide" id="s8" hidden>
    <div class="pad">
      <p class="kick">בגרות 2022, 2024, 2025 · מושגים 2021, 2025</p>
      <h2>תיירות מרפא מול תיירות ריפוי</h2>
      <div class="vs">
        <div class="card">
          <span class="t">תיירות מרפא</span>
          <p class="mini">ניצול <b>סגולות הטבע</b> לבריאות ולנופש: מעיינות חמים, מים מינרליים, בוץ, אוויר ואקלים, בשילוב מנוחה, ספא ובידור.</p>
          <div class="plan"><table>
            <tr><th>אתר</th><th>מיקום</th></tr>
            <tr><td class="d">ים המלח</td><td>ים המלח</td></tr>
            <tr><td class="d">חמת גדר</td><td>רמת הגולן</td></tr>
            <tr><td class="d">חמי טבריה</td><td>הגליל התחתון</td></tr>
            <tr><td class="d">חמי געש</td><td>מישור החוף</td></tr>
          </table></div>
        </div>
        <div class="card">
          <span class="t">תיירות ריפוי</span>
          <p class="mini">נסיעה למדינה אחרת כדי לקבל <b>טיפול רפואי</b>: קליני, ניתוח או שיקום, שאינו קיים בארץ המוצא או שרמתו שם נמוכה. מגיעים לבתי חולים גדולים, גם ממדינות בלי יחסים דיפלומטיים.</p>
          <p class="mini"><b>התרומה לענף:</b> זו לא תיירות להנאה, אבל השהייה ארוכה, והמשפחה המלווה לנה במלון ומשתמשת במסעדות ובהסעות. לכן היא נכללת בתיירות (מחוון 2024).</p>
        </div>
      </div>
      <p class="seen"><b>מרפא בים המלח נלמד:</b><a href="../../deadsea/01/#s7">ים המלח 1 · חופשה שהיא גם טיפול</a><a href="../../golan/02/#s6">הגולן 2 · חמת גדר</a></p>
    </div>
  </section>

  <!-- 9 -->
  <section class="slide stop" id="s9" hidden>
    <div class="pad">
      <p class="kick">תרגול מהיר · בסטודיו</p>
      <h2>שאלות 1–4</h2>
      <div class="q"><span class="qn">1</span><div class="qt">התאימו כל פעילות לסוג התיירות: חיפה, עכו וראש הנקרה ביום אחד; סיור בשכונות החרדיות; רפטינג בירדן; ניתוח בבית חולים; טבילה בחמי טבריה.<span class="tag">התאמה</span></div></div>
      <div class="q"><span class="qn">2</span><div class="qt">מיינו לשלוש רמות הנופש: ונציה הצפופה, מלון חוף משפחתי, אי פרטי עם וילות.<span class="tag">מיון</span></div></div>
      <div class="q"><span class="qn">3</span><div class="qt">סמנו את המאפיינים של ביקור משפחות.<span class="tag">בחירה מרובה</span></div></div>
      <div class="q"><span class="qn">4</span><div class="qt">מהו "טיול כוכב", ולמה הוא מתאים לגיל הזהב?<span class="tag">בחירה</span></div></div>
    </div>
  </section>

