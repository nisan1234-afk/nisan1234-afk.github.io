      <div class="two">
        <div class="plan tblwrap"><table>
          <tr><th></th><th>סיור רגולרי</th><th>רכב אשכול</th></tr>
          <tr><td class="d">אופי</td><td>קבוצתי</td><td>פרטי</td></tr>
          <tr><td class="d">מסלול</td><td>קבוע</td><td>מותאם לתייר</td></tr>
